# Beginner-friendly tmux config
# Mouse-driven, no prefix-key memorization needed.
# Place at ~/.tmux.conf

# Mouse mode ON — click to focus panes, drag to resize
set -g mouse on

# 256 color terminal
set -g default-terminal "screen-256color"
set -ga terminal-overrides ",*256col*:Tc"

# Simple status bar — hostname left, time right
set -g status-style "bg=#1a1b26,fg=#a9b1d6"
set -g status-left " #[fg=#7dcfff]#S #[default]"
set -g status-right "#[fg=#7dcfff] %H:%M #[default]"

# Alt+arrows switch panes (no Ctrl+B prefix needed)
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

# Performance & quality-of-life
set -g history-limit 50000
set -sg escape-time 0          # No lag after Escape
set -g base-index 1             # Windows start at 1
set -g allow-rename off         # Don't auto-rename windows
set -g visual-activity off      # Less noise
