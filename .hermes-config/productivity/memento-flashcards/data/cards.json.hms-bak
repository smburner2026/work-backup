    },
    {
      "id": "b7ccd841-6d5e-498c-9b9b-59ff3f118625",
      "question": "What is the primary defence protein against heavy metals and how does it work?",
      "answer": "Metallothionein — a cysteine-rich (30%) intracellular protein that binds and sequesters metals (Cd, Zn, Cu, Hg). Inducible upon metal exposure.",
      "collection": "DABT - Metal Tox",
      "status": "learning",
      "ease_streak": 0,
