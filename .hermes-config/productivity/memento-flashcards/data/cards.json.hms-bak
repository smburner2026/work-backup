    },
    {
      "id": "03f6bb65-1fd2-4e85-9f25-51736d4cfe60",
      "question": "Define Cancer Slope Factor (CSF).",
      "answer": "The upper-bound 95% estimate of excess cancer risk per unit dose. Units: (mg/kg/day)⁻¹. Risk = CSF × Dose",
      "collection": "DABT - Risk Assessment",
      "status": "learning",
      "ease_streak": 0,
