    {
      "id": "5973afb4-07c4-4f2c-ac37-b7efca45f869",
      "question": "What are the three main mechanisms of heavy metal toxicity?",
      "answer": "(1) Binding to sulfhydryl (SH) groups → enzyme inhibition. (2) Metal substitution in metalloenzymes. (3) Oxidative stress via redox cycling.",
      "collection": "DABT - Metal Tox",
      "status": "learning",
      "ease_streak": 0,
