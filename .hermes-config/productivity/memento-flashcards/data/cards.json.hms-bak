    {
      "id": "bceba9d1-d073-446b-8f38-05976fc8f6f5",
      "question": "How do the carcinogenic mechanisms differ between As, Cd, and Cr?",
      "answer": "As: genotoxic + epigenetic (oxidative stress, altered DNA repair, aberrant methylation). Cd: indirect genotoxic (oxidative stress, inhibited DNA repair). Cr(VI): direct genotoxic (DNA adducts, strand breaks via intracellular reduction).",
      "collection": "DABT - Metal Tox",
      "status": "learning",
      "ease_streak": 0,
