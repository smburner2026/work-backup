    },
    {
      "id": "48408194-e881-4f1b-89bf-8eb6e20a036e",
      "question": "What are the 4 steps of the NRC Red Book (1983) risk assessment framework?",
      "answer": "1. Hazard Identification 2. Dose-Response Assessment 3. Exposure Assessment 4. Risk Characterization",
      "collection": "DABT - Risk Assessment",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-09T12:00:00+00:00",
