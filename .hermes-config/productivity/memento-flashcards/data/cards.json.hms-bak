    {
      "id": "3dad4fa2-a862-4a37-9a46-abf82b5eb7b3",
      "question": "Name two compounds with year-scale half-lives and explain why using the four-compartment TK model.",
      "answer": "TCDD (~7 years), PCBs (years to decades). Four-compartment model: GI — Central (blood) — rapid distribution to Peripheral (fat, deep tissues). Elimination organs can only clear what is in Central. Rate-limiting step = slow redistribution from Peripheral back to Central — extremely long half-life.",
      "collection": "DABT - Conduct of Studies",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-07T20:04:38.076043+00:00",
      "created_at": "2026-05-29T20:04:30.849042+00:00",
      "video_id": "domain-i-blocks1-2-supplement",
      "last_user_answer": null
    },
    {
      "id": "86b54e6d-e928-4c57-a88e-9916ef58254d",
      "question": "A weak base has pKa 8.5. In blood (pH 7.4), what fraction is non-ionized and what does this mean for distribution?",
      "answer": "Henderson-Hasselbalch: pH - pKa = 7.4 - 8.5 = -1.1. Ratio [B]/[BH+] = 10^(-1.1) — about 8% non-ionized (can cross membranes), 92% ionized (trapped). Weak bases are predominantly ionized at physiological pH — tissue trapping in acidic compartments.",
      "collection": "DABT - Conduct of Studies",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-08T20:04:38.076043+00:00",
