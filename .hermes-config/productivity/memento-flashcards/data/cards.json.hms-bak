    {
      "id": "6ce0f438-7aa1-4816-944d-62cbb155e843",
      "question": "What are the three main mechanisms of heavy metal toxicity?",
      "answer": "1. Enzyme inhibition (thiol-binding, e.g., Pb→ALAD, Hg→Se-dependent enzymes) 2. Oxidative stress (Fenton chemistry, ROS, e.g., Fe, Cu, Cr, As) 3. Genotoxicity (DNA adducts, chromosomal damage, e.g., Cr(VI), As, Ni)",
      "collection": "DABT - Metal Tox",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2027-05-29T21:37:58.758269+00:00",
