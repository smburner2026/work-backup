    },
    {
      "id": "744fa7b5-3abb-4553-9643-e8a191132cf4",
      "question": "What is linear (non-threshold) low-dose extrapolation?",
      "answer": "Assumes risk is proportional to dose with no threshold. Used for genotoxic carcinogens. Risk = CSF × Dose",
      "collection": "DABT - Risk Assessment",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-08T21:40:05.618828+00:00",
      "created_at": "2026-05-26T23:48:48.157124+00:00",
      "video_id": "dose-response-ladder",
      "last_user_answer": "Assumes even one molecule can cause cancer, no threshold, risk proportional to dose. Used for genotoxic carcinogens.",
      "last_rated_at": "2026-06-01T23:02:40.982465+00:00"
    },
    {
      "id": "33fcc7ef-9b6a-487b-86a9-8e52e1bad3c3",
      "question": "What is nonlinear (threshold) low-dose extrapolation?",
      "answer": "Assumes a dose exists below which no adverse effect occurs. Used for non-cancer endpoints and non-genotoxic carcinogens. Results in RfD/RfC",
      "collection": "DABT - Risk Assessment",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-10T16:17:18.874576+00:00",
      "created_at": "2026-05-26T23:48:48.157124+00:00",
      "video_id": "dose-response-ladder",
      "last_user_answer": "Assumes a dose exists below which no adverse effect occurs. Used for non-cancer endpoints and non-genotoxic carcinogens. Results in RfD/RfC",
      "last_rated_at": "2026-06-01T23:02:40.982465+00:00"
    },
    {
      "id": "3fc61bb8-7782-46ad-8d3f-7abaf920cfaa",
      "question": "Why do genotoxic carcinogens use linear extrapolation?",
      "answer": "A single DNA-reactive molecule can cause a mutation in a critical gene (oncogene, tumor suppressor). No theoretical threshold exists",
      "collection": "DABT - Risk Assessment",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-08T21:40:39.924192+00:00",
      "created_at": "2026-05-26T23:48:48.157124+00:00",
      "video_id": "dose-response-ladder",
      "last_user_answer": "Single DNA-reactive molecule can mutate a critical gene, no theoretical threshold",
      "last_rated_at": "2026-06-01T23:03:10.230352+00:00"
    },
    {
      "id": "04e92886-ecf5-4c6d-ae61-a5a3a61b907a",
      "question": "Why do non-genotoxic carcinogens use a threshold approach?",
      "answer": "Tumor formation requires sustained cytotoxicity, regenerative hyperplasia, or receptor activation above a threshold dose — below that, no tumor promotion",
      "collection": "DABT - Risk Assessment",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-08T21:41:18.923997+00:00",
      "created_at": "2026-05-26T23:48:48.157124+00:00",
      "video_id": "dose-response-ladder",
      "last_user_answer": "Non-genotoxic carcinogens don't directly damage DNA - tumor requires sustained cytotoxicity or receptor activation above a threshold",
      "last_rated_at": "2026-06-01T23:03:10.230352+00:00"
    },
    {
      "id": "e8f8e40c-f22c-4eff-888c-3634e8d08284",
      "question": "What default model is used for a chemical positive in the Ames test?",
      "answer": "Linear (non-threshold) — Ames positive suggests genotoxicity, so the default is no threshold",
