    },
    {
      "id": "ed751573-b415-40f1-b6c8-c881d69d0854",
      "question": "What chemical functional group do most heavy metals target on cellular proteins?",
      "answer": "Sulfhydryl (SH) / thiol groups — present in cysteine residues. Binding inactivates enzymes (toxicity) or depletes glutathione (oxidative stress).",
      "collection": "DABT - Metal Tox",
      "status": "learning",
