      "video_id": "dose-response-ladder",
      "last_user_answer": "Upper-bound 95% estimate of excess cancer risk per unit dose, units (mg/kg/day)-1, Risk = CSF × Dose",
      "last_rated_at": "2026-06-01T23:03:10.230352+00:00"
    },
    {
      "id": "96b5d24a-7b36-48f2-a567-62858cbf70d3",
      "question": "Why do regulators use the upper-bound slope rather than the central estimate for CSF?",
      "answer": "To avoid underestimating risk when data are sparse. Same philosophy as using BMDL instead of BMD — builds in a margin for study uncertainty",
      "collection": "DABT - Risk Assessment",
      "status": "learning",
      "ease_streak": 1,
