    },
    {
      "id": "d7e12018-0c09-4716-bcc6-5177041df775",
      "question": "How does Cr(VI) cause DNA damage inside cells?",
      "answer": "Cr(VI) enters cells → intracellular reduction to Cr(III) → generates reactive oxygen species (ROS) → DNA adducts, strand breaks, and cross-links. Cr(III) itself binds DNA phosphate backbone.",
      "collection": "DABT - Metal Tox",
      "status": "learning",
      "ease_streak": 0,
