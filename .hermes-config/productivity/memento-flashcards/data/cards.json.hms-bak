    },
    {
      "id": "a518834d-0f65-4fa5-ade1-b1631e5e6813",
      "question": "Why does valence determine heavy metal toxicity?",
      "answer": "Lower-valent/trivalent forms (As³⁺) bind SH groups more readily than higher-valent forms (As⁵⁺). Cr(VI) enters cells easily and is reduced to Cr(III) intracellularly → DNA damage.",
      "collection": "DABT - Metal Tox",
      "status": "learning",
