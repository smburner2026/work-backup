      "video_id": "conduct-of-studies-block3-stats",
      "last_user_answer": null
    },
    {
      "id": "0f398dc8-c481-438e-a75d-9a3e241535b9",
      "question": "A 2-year rat bioassay reports tumor incidence across 4 dose groups (control, low, mid, high). Which test detects a monotonic dose-related trend in proportions?",
      "answer": "Cochran-Armitage trend test. It specifically tests for monotonic increase in proportion with increasing dose. χ² only tells you 'at least one group differs' — it ignores dose ordering and is less powerful for detecting a true dose-response.",
      "collection": "DABT - Conduct of Studies",
      "status": "learning",
      "ease_streak": 0,
      "next_review_at": "2026-06-10T12:00:00+00:00",
