      "last_user_answer": null
    },
    {
      "id": "cb4fa369-ee6e-4598-8ef6-d8310aa3332c",
      "question": "What is the blood-brain barrier (BBB) composed of, and which types of toxicants CAN cross it?",
      "answer": "BBB = tight junctions between brain capillary endothelial cells + astrocyte foot processes. Can cross: (1) lipophilic compounds (passive diffusion), (2) compounds with active transporters (methylmercury-cysteine mimics methionine), (3) small gases (CO, ethanol). Cannot cross: polar/ionized compounds or large molecules.",
      "collection": "DABT - Conduct of Studies",
      "status": "learning",
